# Statera environment variables

# Application
APP_NAME=Statera
APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://statera:CHANGE_ME@POSTGRES_FQDN:6432/statera?sslmode=verify-full&sslrootcert=/absolute/path/to/CA.pem

# LinkedIn (smoke test + ingestion + description fetch)
PLAYWRIGHT_HEADLESS=false
LINKEDIN_STORAGE_STATE=var/playwright/linkedin-storage-state.json
LINKEDIN_SEARCH_URL=https://www.linkedin.com/jobs/search/?keywords=example
LINKEDIN_DEBUG_PAUSE=false
LINKEDIN_DUMP_DOM=false
LINKEDIN_DESCRIPTION_FETCH_LIMIT=5

# LLM analysis (provider-neutral; default provider is DeepSeek)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARACTERS=

VACANCY_ANALYSIS_BATCH_LIMIT=5
VACANCY_ANALYSIS_PROMPT_VERSION=vacancy-fit-v4

# Private career documents (store under var/private/, never commit)
MASTER_CAREER_BRIEF_PATH=var/private/master-career-brief.docx
MASTER_RESUME_PATH=
RESUME_TEMPLATE_PATH=
APPLICATION_RULES_PATH=
SCORING_RULES_PATH=

# DeepSeek adapter (only required when LLM_PROVIDER=deepseek and a real script runs)
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI adapter (inactive by default; only required when LLM_PROVIDER=openai)
# OPENAI_API_KEY=CHANGE_ME
